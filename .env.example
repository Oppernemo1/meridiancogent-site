# --- Program sign-up form / Resend integration ---
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Resend Segment the contact is added to (https://resend.com/segments)
# (RESEND_AUDIENCE_ID is still read as a fallback if this is unset.)
RESEND_SEGMENT_ID=

# Verified sender. Must be on a domain verified in Resend.
RESEND_FROM_EMAIL="MeridianCogent <noreply@meridiancogent.com>"

# Where internal "new signup" notifications are sent (role-based address).
INTERNAL_NOTIFICATION_EMAIL=hello@meridiancogent.com

# Secret used to sign one-click unsubscribe links (HMAC). Falls back to
# RESEND_API_KEY if unset, but set a dedicated value in production.
UNSUBSCRIBE_SECRET=

# --- Site ---
# Canonical origin, no trailing slash. Used for canonical URLs, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://www.meridiancogent.com
